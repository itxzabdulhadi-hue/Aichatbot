# Neon PostgreSQL connection string (server only, use sslmode=require)
DATABASE_URL=
# Generate once with: openssl rand -hex 32. Keep it stable and back it up securely.
CREDENTIAL_ENCRYPTION_KEY=
# Optional trusted HTTPS endpoint for OpenAI-compatible providers
OTHER_AI_BASE_URL=
# Optional SMTP settings for password recovery; APP_URL must be the trusted HTTPS site origin in production
SMTP_URL=
SMTP_FROM=
APP_URL=
